  C_mat, 
  Max, Slopes, Ec50s, 
  interact="DL",
  a = DL_fit$a,
  b = DL_fit$b
  )
res_DR <- CA_complete2(
  C_mat, 
  Max, Slopes, Ec50s, 
  interact="DR",
  a = DR_fit$a,
  b = DR_fit$b
  )

# We add the corresponding response to our design
